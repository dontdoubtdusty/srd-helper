<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: a normal Windows app, so no black console window opens behind it -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>SrdDesk</AssemblyName>
    <!-- The -windows target and UseWindowsForms are only for the native "Open file" dialog -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The mascot as the exe and shortcut icon -->
    <ApplicationIcon>resources/mascot.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="Raylib-cs" Version="8.0.0" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="resources\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="samples\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
